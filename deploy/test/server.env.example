# AI 서버 test 설정 (비밀번호 없음). 서버의 /opt/runiverse-ai-server/config/server.env로 복사해 쓴다
# 비밀번호·CA는 /opt/runiverse-ai-server/secrets/ 파일로 (컨테이너 /run/secrets/ai-server, 읽기 전용)

KAFKA_ENV=test
KAFKA_BOOTSTRAP_SERVERS=12.16.16.198:9092
KAFKA_PASSWORD_FILE=/run/secrets/ai-server/kafka_password
KAFKA_CA_PATH=/run/secrets/ai-server/kafka-ca.crt

AI_BUCKET_NAME=s3-runiverse-ai-music-test
INPUT_PREFIX=async/inputs/test
ENDPOINT_NAME=runiverse-music-test-v1
AWS_REGION=ap-northeast-2
# AWS 자격 증명은 EC2 인스턴스 역할 (키를 넣지 않는다)

DB_HOST=12.16.16.198
DB_PORT=3307
DB_NAME=runiverse_ai_test
DB_USER=runiverse_ai
DB_PASSWORD_FILE=/run/secrets/ai-server/db_password
